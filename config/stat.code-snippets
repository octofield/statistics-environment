    "sympy 求 pdf 常數 k 與期望值": {
        "scope": "python",
        "prefix": "sympdf",
        "description": "自訂 pdf 求常數 k、E[X]、Var(X)。f：含 k 的 pdf；lo、hi：x 的範圍；sp.integrate(式子, (x, 下限, 上限)) 積分；sp.solve(sp.Eq(左, 右), k) 解方程式",
        "body": [
            "x, k = sp.symbols('x k', positive=True)",
            "f = k * ${1:sp.exp(2 * x)}  # pdf（含常數 k）",
            "lo, hi = ${2:1}, ${3:2}  # x 的範圍",
            "k_val = sp.solve(sp.Eq(sp.integrate(f, (x, lo, hi)), 1), k)[0]  # 積分 = 1 解 k",
            "f = f.subs(k, k_val)",
            "EX = sp.integrate(x * f, (x, lo, hi))  # E[X] = ∫ x f(x) dx",
            "VarX = sp.integrate(x ** 2 * f, (x, lo, hi)) - EX ** 2  # Var(X) = E[X²] - E[X]²",
            "print('k =', sp.simplify(k_val), float(k_val))",
            "print('E[X] =', sp.simplify(EX), float(EX))",
            "print('Var(X) =', sp.simplify(VarX), float(VarX))$0"
        ]
    },

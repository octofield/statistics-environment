    "敘述統計（statistics）": {
        "scope": "python",
        "prefix": "desc",
        "description": "常用敘述統計量。pvariance / pstdev：母體（除以 N）；variance / stdev：樣本（除以 n − 1）；quantiles(n=4)：四分位數（講義的 exclusive 算法）；multimode：所有眾數",
        "body": [
            "values = list(${1:x})  # 資料",
            "print('mean:              ', statistics.mean(values))",
            "print('median:            ', statistics.median(values))",
            "print('mode(s):           ', statistics.multimode(values))",
            "print('population var:    ', statistics.pvariance(values))  # 母體：除以 N",
            "print('sample var:        ', statistics.variance(values))   # 樣本：除以 n - 1",
            "print('population std:    ', statistics.pstdev(values))",
            "print('sample std:        ', statistics.stdev(values))",
            "q1, q2, q3 = statistics.quantiles(values, n=4)  # n=4：四分位數；n=100：百分位數",
            "print('Q1, Q2, Q3:        ', q1, q2, q3)",
            "print('IQR:               ', q3 - q1)$0"
        ]

        "description": "兩個隨機變數的聯合機率表。p[i][j] = Pr(X = xs[i], Y = ys[j])；邊際機率是列、欄加總；Cov = E[XY] − μxμy；ρ = Cov / (σxσy)；獨立要每一格都等於邊際相乘（Cov = 0 不一定獨立）",
        "body": [
            "xs = [${1:0, 1}]  # X 的可能值（列）",
            "ys = [${2:1, 2, 3}]  # Y 的可能值（欄）",
            "p = [[${3:0.1, 0.2, 0.2}], [${4:0.2, 0.2, 0.1}]]  # 聯合機率",
            "px = [sum(row) for row in p]  # 邊際 Pr(X = x)",
            "py = [sum(p[i][j] for i in range(len(xs))) for j in range(len(ys))]  # 邊際 Pr(Y = y)",
            "mu_x = sum(x * q for x, q in zip(xs, px))",
            "mu_y = sum(y * q for y, q in zip(ys, py))",
            "exy = sum(xs[i] * ys[j] * p[i][j] for i in range(len(xs)) for j in range(len(ys)))  # E[XY]",
            "cov = exy - mu_x * mu_y  # Cov(X, Y) = E[XY] − μxμy",
            "var_x = sum(x ** 2 * q for x, q in zip(xs, px)) - mu_x ** 2",
            "var_y = sum(y ** 2 * q for y, q in zip(ys, py)) - mu_y ** 2",
            "print(round(cov, 4), round(cov / math.sqrt(var_x * var_y), 4))  # 共變異數、相關係數",
            "print(all(abs(p[i][j] - px[i] * py[j]) < 1e-9 for i in range(len(xs)) for j in range(len(ys))))  # True = 獨立$0"

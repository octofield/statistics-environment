    "柴比雪夫 / 經驗法則": {
        "scope": "python",
        "prefix": "cheb",
        "description": "驗證柴比雪夫定理：至少 1 − 1/k² 的資料落在 μ ± kσ。pstdev：母體標準差（講義）；stdev：樣本標準差（題目說視為樣本時）；k：幾個標準差",
        "body": [
            "values = list(${1:x})  # 資料",
            "mu = statistics.mean(values)",
            "sd = statistics.${2|pstdev,stdev|}(values)  # pstdev：母體；stdev：樣本",
            "for k in [${3:1.5, 2}]:  # k：幾個標準差",
            "    lower, upper = mu - k * sd, mu + k * sd",
            "    within = len([v for v in values if lower <= v <= upper]) / len(values)",
            "    print(f'k = {k}: [{lower:.2f}, {upper:.2f}], actual = {within:.4f}, Chebyshev bound = {1 - 1 / k ** 2:.4f}')$0"
        ]
    },
    "1.5 IQR 離群值": {
        "scope": "python",
        "prefix": "outlier",
        "description": "1.5 IQR 規則：小於 Q1 − 1.5·IQR 或大於 Q3 + 1.5·IQR 的是離群值。quantiles(n=4) 回傳 Q1、Q2、Q3",
        "body": [
            "q1, _, q3 = statistics.quantiles(list(${1:x}), n=4)  # Q1、Q2（不用）、Q3",
            "iqr = q3 - q1",
            "lower, upper = q1 - 1.5 * iqr, q3 + 1.5 * iqr  # 1.5：倍數",
            "outliers = [v for v in ${1:x} if v < lower or v > upper]",
            "print(f'range = [{lower:.2f}, {upper:.2f}], {len(outliers)} outlier(s): {outliers}')$0"
        ]
    },

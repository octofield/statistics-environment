{
    // Ctrl+Shift+P →「工作: 執行工作」→ 選一個
    "version": "2.0.0",
    "tasks": [
        {
            "label": "匯入考卷",
            "detail": "選老師給的 .ipynb（選檔視窗預設開在「下載」），複製到 exam/（保留原檔名）、在最上面加上 import 與設定，再打開",
            "type": "process",
            "command": "${workspaceFolder}/../__WINPY__/python/python.exe",
            "args": ["${workspaceFolder}/tools/import_exam.py", "--open"],
            "options": { "env": { "PYTHONUTF8": "1", "PYTHONNOUSERSITE": "1" } },
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "匯出目前的 notebook 成 HTML",
            "detail": "匯出正在編輯的 .ipynb（圖片內嵌），並檢查檔名、執行順序、錯誤，另存備份到 _backup/",
            "type": "process",
            "command": "${workspaceFolder}/../__WINPY__/python/python.exe",
            "args": ["${workspaceFolder}/tools/export_html.py", "${file}"],
            "options": { "env": { "PYTHONUTF8": "1", "PYTHONNOUSERSITE": "1" } },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "匯出目前的 notebook 成 HTML（先從頭重新執行）",
            "detail": "等於「重新啟動 → 全部執行」後再匯出，可以確認沒有執行順序的問題（請先存檔）",
            "type": "process",
            "command": "${workspaceFolder}/../__WINPY__/python/python.exe",
            "args": ["${workspaceFolder}/tools/export_html.py", "${file}", "--execute"],
            "options": { "env": { "PYTHONUTF8": "1", "PYTHONNOUSERSITE": "1" } },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "環境檢查",
            "detail": "套件、statkit、中文字型、HTML 匯出、AI 擴充",
            "type": "process",
            "command": "${workspaceFolder}/../__WINPY__/python/python.exe",
            "args": ["${workspaceFolder}/tools/check_env.py"],
            "options": { "env": { "PYTHONUTF8": "1", "PYTHONNOUSERSITE": "1" } },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        }
    ]
}
